
#include <stdio.h>

int main()
{
    int i;
    int numbers[10];
    int allnum=0;
    printf("Insert 10 numbers\n");
    for(i=0; i<10; i++){
        scanf("%d",&numbers[i] );
        allnum = allnum+numbers[i];
    }
    allnum = allnum/10;
    printf("the average is: %d",allnum);

    return 0;
}
