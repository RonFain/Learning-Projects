
public class Main
{
	public static void main(String[] args) {
		int[] arr = {1,9,3};
		int time = 5;
		System.out.println(minTime(arr,9));
	}
	public static int total(int[] arr, int numSeconds){
	    int count = 0;
	    for(int i = 0; i<arr.length; i++){
	        count += numSeconds / arr[i];
	    }
	    return count;
	}
	
	public static int minTime(int[] arr, int amount){
	    int time = 0;
	    while(total(arr,time) < amount){
	        time++;
	    }
	    return time;
	}
}
