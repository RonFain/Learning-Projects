
public class Main
{
	public static void main(String[] args) {
		int[] arr = {1,4,0,37,5,5,5,0,1,455,2};
		System.out.println(biggestNum(arr));
	}
	public static int biggestNum(int[] arr){
	    int max = 0, sum = 0;
	    int i = 0;
	    while(i<arr.length && arr[i] != 0 ){
	        i++;
	    }
	    for(;i<arr.length; i++){
	        if(arr[i] != 0 ){
	            sum += arr[i];
	        }
	        else{
	            if(sum > max){
	                max = sum;
	            }
	            sum = 0;
	        }
	    }
	    return max;
	}
}
