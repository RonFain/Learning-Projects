import java.util.*;
public class Main
{
	public static void main(String[] args) {
		int num1 = getNum();
		int num2 = getNum();
		System.out.println("Number 1: " + num1);
		System.out.println("Number 2: " + num2);
		System.out.println("Change of numbers: " + change(num1,num2));
	}
	public static int change(int n1, int n2){
	    Num3Digit number1 = new Num3Digit(n1);
	    Num3Digit number2 = new Num3Digit(n2);
	    int d100 = Math.abs(number1.getHunds() - number2.getHunds());
	    int d10 = Math.abs(number1.getTens() - number2.getTens());
	    int d1 = Math.abs(number1.getUnits() - number2.getUnits());
	    return d100 * 100 + d10 * 10 + d1;
	}
	public static int getNum(){
	    Scanner sc = new Scanner(System.in);
	    System.out.println("Enter a 3 digit number");
	    int num = sc.nextInt();
	    while(num < 100 && num > 1000){
	        System.out.println("Try again, Enter a 3 digit number");
	        num = sc.nextInt();
	    }
	    return num;
	}
	    
}
class Num3Digit{
    private int num;
    public Num3Digit(int num){
        this.num = num;
    }
    public Num3Digit(int d100, int d10, int d1){
        this.num = d100 * 100 + d10*10 + d1;
    }
    public int getUnits(){
        return num % 10;
    }
    public int getTens(){
        return (num / 10)%10;
    }
    public int getHunds(){
        return num / 100;
    }
    public String toString(){
        return "Num = " + num;
    }
    
}
