  
#include <stdio.h>

int main()
{
    
    int input=0;
    int average=0;
    int max=0;
    int i=-1;
    printf("insert numbers\n");
    
    
    do{
        scanf("%d",&input);
        i++;
        if(input == -1){
            break;
        }
        average = average+input;
        if(max<input){
            max = input;
    }
    }
    while(input != -1);
    average = average/i;
   
    printf("%d is the max number\n",max);
    printf("%d is the average\n",average);
    return 0;
}
