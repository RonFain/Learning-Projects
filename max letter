def max_letter(input_string):
    if not input_string:
        print("wrong")
        return None
    max_char = input_string[0]
    for char in input_string:
        if char > max_char:
            max_char = char
    return max_char
    
string = input("Insert a word: ")
result = max_letter(string)
if result != None:
    print(f"The maximum letter in the word is: {result}")
