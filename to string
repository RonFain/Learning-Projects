import java.util.*;
public class Main
{
	public static void main(String[] args) {
		int[][]met = new int[3][3];
		Scanner sc = new Scanner(System.in);
		for(int i=0;i<met.length;i++){
		    for(int x=0;x<met[i].length;x++){
		        met[i][x] = sc.nextInt();
		    }
		}
		for(int i=0;i<met.length;i++){
		    for(int x=0;x<met[i].length;x++){
		        System.out.print(met[i][x]);
		    }
		}
		
	}
}


